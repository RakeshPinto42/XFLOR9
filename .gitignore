# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright MCP screenshots/snapshots
/.playwright-mcp/

# Generated malicious/malformed EPUBs for security tests (regenerate: node scripts/books/make-security-fixtures.ts).
# Not committed: includes a zip bomb and a 5 MB file, and the repo is public.
/test-fixtures/security/

# Playwright security suite output
/test-results/
/playwright-report/
/.next-security/

# Downloaded book sources (untrusted input for scripts/books/prepare-epub.ts)
/.cache/
